{
  "name": "kinetix-identity-service",
  "version": "1.0.0",
  "description": "Kinetix Identity Service - Authentication, Profile, 2FA, OAuth, and Seller Onboarding (NestJS Fastify + gRPC Server + Bun Runtime Hexagonal Architecture)",
  "author": "Wildan Frananda",
  "license": "MIT",
  "module": "src/main.ts",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "start:prod": "bun run dist/main.js",
    "test": "jest --config jest.config.cjs"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
