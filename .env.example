# Kinetix Identity Service — environment template
#
# Copy to .env and fill every value in. There are no defaults: the service refuses to
# start when the signing key or DB_PASSWORD is missing, so a forgotten value fails loudly
# instead of silently falling back to a shared literal.
#
# Generate a secret with:  head -c 48 /dev/urandom | base64
# Never commit the filled-in .env, and never reuse a value across services.

PORT=5000
GRPC_PORT=50052

# Database. The application reads these names — DATABASE_URL is not used.
DB_HOST=localhost
DB_PORT=5436
DB_USERNAME=kinetix_identity_app
DB_DATABASE=kinetix_identity_dev
DB_PASSWORD=

# Token signing. The private key is the base64 of a whole PEM file, PKCS#8 RSA of at
# least 2048 bits. The previous keys are optional: the base64 of one or more PEM public
# keys, one after another, that signed before the current one. They are published in
# the JWKS and verified, never used to sign.
KINETIX_IDENTITY_JWT_PRIVATE_KEY_B64=
KINETIX_IDENTITY_JWT_PREVIOUS_PUBLIC_KEYS_B64=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
