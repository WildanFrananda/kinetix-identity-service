# Kinetix Identity Service — environment template
#
# Copy to .env and fill every value in. There are no defaults: the service refuses to
# start when any of these is missing, so a forgotten value fails loudly instead of
# silently falling back to a literal.
#
# Generate a secret with:  head -c 48 /dev/urandom | base64
# Never commit the filled-in .env, and never reuse a value across services.

PORT=5000
GRPC_PORT=50052

# Database. The application reads these names — DATABASE_URL is not used.
DB_HOST=localhost
DB_PORT=5436
DB_USERNAME=kinetix_identity_app
DB_DATABASE=kinetix_identity_dev
DB_PASSWORD=

# Token signing. The private key is the base64 of a whole PEM file, PKCS#8 RSA of at
# least 2048 bits. The previous keys are optional: the base64 of one or more PEM public
# keys, one after another, that signed before the current one. They are published in
# the JWKS and verified, never used to sign.
KINETIX_IDENTITY_JWT_PRIVATE_KEY_B64=
KINETIX_IDENTITY_JWT_PREVIOUS_PUBLIC_KEYS_B64=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Geocoding. OpenStreetMap's Nominatim refuses anonymous requests, so the user agent must
# name this deployment and a contact address. Point the base URL at a self-hosted
# Nominatim when the public one's usage policy no longer fits.
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=

# The fleet (matching) that a courier's vehicle is filed in, over the mesh.
MATCHING_GRPC_HOST=

# Client proof. Login, the two-factor answer, both registrations and refresh read the client's
# name from X-Kinetix-Client; a client whose proof is app_check also sends a Firebase App Check
# token in X-Firebase-AppCheck. IDENTITY_CLIENTS is name:proof pairs, comma-separated, a proof
# being app_check or none (none is an explicit choice for the lab and for a rollout, never a
# fallback). IDENTITY_UNNAMED_CLIENTS is allow or refuse: what a request naming no client gets.
#   Lab:        IDENTITY_CLIENTS=courier-app:none       IDENTITY_UNNAMED_CLIENTS=allow
#   Production: IDENTITY_CLIENTS=courier-app:app_check  IDENTITY_UNNAMED_CLIENTS=allow, then
#               refuse once every installed courier app sends the headers.
IDENTITY_CLIENTS=
IDENTITY_UNNAMED_CLIENTS=

# Required while any client uses app_check, and read only then. The Firebase project's NUMBER
# (console, Project settings), not its id. One IDENTITY_APP_CHECK_APP_IDS_<NAME> per app_check
# client, the name upper-cased with "-" as "_": the comma-separated Firebase app ids
# (1:<project number>:<platform>:<hash>) whose App Check tokens that client may present.
FIREBASE_PROJECT_NUMBER=
IDENTITY_APP_CHECK_APP_IDS_COURIER_APP=
